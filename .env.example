# ============================================
# LLM Provider — elige uno como principal
# ============================================
GOOGLE_API_KEY=tu_api_key_de_gemini_aqui
GROQ_API_KEY=tu_api_key_de_groq_aqui
HUGGINGFACE_API_KEY=tu_api_key_de_huggingface_aqui

# Modelo a usar (ajusta según el proveedor elegido)
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.3

# ============================================
# Decathlon Developer API
# https://developers.decathlon.com
# ============================================
DECATHLON_API_KEY=tu_api_key_de_decathlon_aqui
DECATHLON_CLIENT_ID=tu_client_id_aqui
DECATHLON_CLIENT_SECRET=tu_client_secret_aqui
DECATHLON_BASE_URL=https://api.decathlon.com

# ============================================
# Config general del agente
# ============================================
APP_ENV=development
LOG_LEVEL=INFO
