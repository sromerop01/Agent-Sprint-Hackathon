# ============================================
# LLM Provider — completa la key del que vayas a usar
# ============================================
GOOGLE_API_KEY=tu_api_key_de_gemini_aqui
GROQ_API_KEY=tu_api_key_de_groq_aqui

# Cual proveedor usar: google | groq
# (debe coincidir con la API key que llenaste arriba)
LLM_PROVIDER=google

# Modelo a usar (debe existir para el proveedor elegido arriba)
# ej: google -> gemini-2.5-flash | groq -> llama-3.3-70b-versatile
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.3


# ============================================
# Config general del agente
# ============================================
APP_ENV=development
LOG_LEVEL=INFO
